---
// src/pages/program.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const kurikulum = {
    nama: "Kurikulum Merdeka",
    deskripsi:
        "Kurikulum yang berfokus pada pengembangan kompetensi siswa melalui pembelajaran berdiferensiasi",
    fitur: [
        "Projek Penguatan Profil Pelajar Pancasila",
        "Pembelajaran berbasis masalah",
        "Fleksibilitas bagi guru dan siswa",
    ],
};

const programUnggulan = [
    {
        nama: "Kelas Bilingual",
        deskripsi: "Pembelajaran dalam Bahasa Indonesia dan Inggris",
        icon: "🌐",
    },
    {
        nama: "STEM Club",
        deskripsi: "Program pengembangan sains dan teknologi",
        icon: "🔬",
    },
    {
        nama: "Program Tahfiz",
        deskripsi: "Menghafal Al-Qur'an untuk siswa muslim",
        icon: "📖",
    },
];

const ekstrakurikuler = [
    "Pramuka",
    "Robotik",
    "Debat Bahasa Inggris",
    "Basket",
    "Teater",
    "KIR",
];
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Program & Kurikulum - NAMA SEKOLAH</title>
    </head>
    <body class="bg-gray-50">
        <Header />

        <!-- Hero Section -->
        <section
            class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-20"
        >
            <div class="container mx-auto px-4 text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    Program & Kurikulum
                </h1>
                <p class="text-xl">
                    Pengalaman belajar terbaik untuk masa depan gemilang
                </p>
            </div>
        </section>

        <!-- Kurikulum -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-4 max-w-4xl">
                <div class="text-center mb-12">
                    <span
                        class="bg-blue-100 text-blue-800 px-4 py-2 rounded-full font-medium"
                    >
                        Kurikulum
                    </span>
                    <h2 class="text-3xl font-bold mt-4">{kurikulum.nama}</h2>
                </div>

                <div class="bg-blue-50 rounded-xl p-8 mb-12">
                    <p class="text-lg text-gray-700 mb-6">
                        {kurikulum.deskripsi}
                    </p>
                    <ul class="space-y-3">
                        {
                            kurikulum.fitur.map((item) => (
                                <li class="flex items-start">
                                    <svg
                                        class="h-6 w-6 text-green-500 mr-3 flex-shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <h3
                            class="text-xl font-semibold mb-4 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 text-blue-600"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                ></path>
                            </svg>
                            Jadwal Pelajaran
                        </h3>
                        <div
                            class="bg-white border rounded-lg overflow-hidden shadow-sm"
                        >
                            <img
                                src="/images/jadwal-pelajaran.jpg"
                                alt="Contoh Jadwal"
                                class="w-full"
                            />
                        </div>
                    </div>

                    <div>
                        <h3
                            class="text-xl font-semibold mb-4 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 text-blue-600"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                                ></path>
                            </svg>
                            Struktur Kurikulum
                        </h3>
                        <div class="bg-white border rounded-lg p-4 shadow-sm">
                            <img
                                src="/images/struktur-kurikulum.png"
                                alt="Struktur Kurikulum"
                                class="w-full"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Program Unggulan -->
        <section class="py-16 bg-gray-100">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
                    Program Unggulan
                </h2>

                <div class="grid md:grid-cols-3 gap-8">
                    {
                        programUnggulan.map((program) => (
                            <div class="bg-white p-8 rounded-xl shadow-md hover:shadow-lg transition-shadow text-center">
                                <div class="text-5xl mb-4">{program.icon}</div>
                                <h3 class="text-xl font-bold mb-2">
                                    {program.nama}
                                </h3>
                                <p class="text-gray-600">{program.deskripsi}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Ekstrakurikuler -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-4 max-w-4xl">
                <h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
                    Ekstrakurikuler
                </h2>

                <div class="flex flex-wrap justify-center gap-4">
                    {
                        ekstrakurikuler.map((item) => (
                            <span class="bg-blue-100 text-blue-800 px-6 py-3 rounded-full font-medium">
                                {item}
                            </span>
                        ))
                    }
                </div>
            </div>
        </section>

        <Footer />
    </body>
</html>
