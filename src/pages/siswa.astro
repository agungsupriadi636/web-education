---
// src/pages/siswa.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const alumnis = await getCollection("alumni");

import osis from "../media/osis.jpg";
import mkr from "../media/mkr.jpg";

// Data dummy
const organisasiSiswa = [
    {
        nama: "OSIS 2023/2024",
        deskripsi: "Organisasi Siswa Intra Sekolah periode 2023/2024",
        logo: osis,
    },
    {
        nama: "MPK 2023/2024",
        deskripsi: "Majelis Perwakilan Kelas periode 2023/2024",
        logo: mkr,
    },
];

const prestasiSiswa = [
    {
        judul: "Juara 1 Olimpiade Matematika Nasional",
        tahun: 2023,
        siswa: "Budi Santoso (XII IPA 1)",
    },
    {
        judul: "Juara 1 Olimpiade fisika Nasional",
        tahun: 2022,
        siswa: "Ratna Indah Sari (XII IPA 1)",
    },
    {
        judul: "Juara 1 Olimpiade kimia Nasional",
        tahun: 2020,
        siswa: "Indah Purwasih (XII IPA 1)",
    },
];
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Siswa & Alumni - NAMA SEKOLAH</title>
    </head>
    <body class="bg-gray-50">
        <Header />

        <!-- Hero Section -->
        <section
            class="bg-gradient-to-r from-blue-700 to-blue-900 text-white py-20"
        >
            <div class="container mx-auto px-4 text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    Siswa & Alumni
                </h1>
                <p class="text-xl">
                    Membangun jejaring dan prestasi generasi penerus
                </p>
            </div>
        </section>

        <!-- Organisasi Siswa -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
                    Organisasi Siswa
                </h2>

                <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                    {
                        organisasiSiswa.map((org) => (
                            <div class="bg-gray-50 p-8 rounded-xl shadow-md hover:shadow-lg transition-shadow text-center">
                                <Image
                                    src={org.logo}
                                    alt={org.nama}
                                    class="w-full aspect-square object-cover rounded-lg mx-auto mb-6"
                                />
                                <h3 class="text-xl font-bold mb-2">
                                    {org.nama}
                                </h3>
                                <p class="text-gray-600">{org.deskripsi}</p>
                                <a
                                    href="#"
                                    class="mt-4 inline-block text-blue-600 hover:underline"
                                >
                                    Lihat Profil
                                </a>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Prestasi Siswa -->
        <section class="py-16 bg-gray-100">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
                    Prestasi Siswa
                </h2>

                <div class="overflow-x-auto">
                    <table
                        class="min-w-full bg-white rounded-lg overflow-hidden"
                    >
                        <thead class="bg-blue-600 text-white">
                            <tr>
                                <th class="py-3 px-4 text-left">Prestasi</th>
                                <th class="py-3 px-4 text-left">Tahun</th>
                                <th class="py-3 px-4 text-left">Siswa</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {
                                prestasiSiswa.map((item) => (
                                    <tr class="hover:bg-blue-50 transition-colors">
                                        <td class="py-4 px-4">{item.judul}</td>
                                        <td class="py-4 px-4">{item.tahun}</td>
                                        <td class="py-4 px-4">{item.siswa}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Alumni Sukses -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
                    Alumni Sukses
                </h2>

                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    {
                        alumnis.map((person) => (
                            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                                <Image
                                    src={person.data.foto}
                                    alt={person.data.nama}
                                    class="w-full aspect-square object-cover"
                                />
                                <div class="p-6">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h3 class="text-xl font-bold">
                                                {person.data.nama}
                                            </h3>
                                            <p class="text-blue-600">
                                                Angkatan {person.data.angkatan}
                                            </p>
                                        </div>
                                        <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm">
                                            {person.data.pekerjaan}
                                        </span>
                                    </div>
                                    <p class="mt-4 text-gray-600 italic">
                                        {person.data.qoute}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Jejaring Alumni -->
        <section class="py-16 bg-gray-100">
            <div class="container mx-auto px-4 text-center max-w-4xl">
                <h2 class="text-3xl font-bold text-blue-800 mb-6">
                    Jejaring Alumni
                </h2>
                <p class="text-lg text-gray-700 mb-6">
                    Bergabunglah dengan jaringan alumni kami untuk berbagi
                    pengalaman dan membangun relasi
                </p>
                <a
                    href="#"
                    class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-colors"
                >
                    Daftar Sekarang
                </a>
            </div>
        </section>

        <Footer />
    </body>
</html>
