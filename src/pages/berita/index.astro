---
// src/pages/berita.astro
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Pagination from "../../components/Pagination.astro";

// Data dummy berita
const berita = [
    {
        id: 1,
        judul: "Siswa Raih Medali Emas Olimpiade Sains Nasional",
        excerpt:
            "Tim sains sekolah berhasil meraih 2 medali emas dalam OSN 2023",
        tanggal: "15 Maret 2023",
        kategori: "Prestasi",
        gambar: "/berita/osn.jpg",
        penulis: "Admin Sekolah",
    },
    {
        id: 2,
        judul: "Siswa Raih Medali Emas Olimpiade Sains Nasional",
        excerpt:
            "Tim sains sekolah berhasil meraih 2 medali emas dalam OSN 2023",
        tanggal: "15 Maret 2023",
        kategori: "Prestasi",
        gambar: "/berita/osn.jpg",
        penulis: "Admin Sekolah",
    },
    {
        id: 3,
        judul: "Siswa Raih Medali Emas Olimpiade Sains Nasional",
        excerpt:
            "Tim sains sekolah berhasil meraih 2 medali emas dalam OSN 2023",
        tanggal: "15 Maret 2023",
        kategori: "Prestasi",
        gambar: "/berita/osn.jpg",
        penulis: "Admin Sekolah",
    },
    // ... tambahkan 5-7 berita lainnya
];

const kategori = [
    { slug: "semua", nama: "Semua Berita" },
    { slug: "prestasi", nama: "Prestasi" },
    { slug: "kegiatan", nama: "Kegiatan" },
    { slug: "pengumuman", nama: "Pengumuman" },
];
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Berita - NAMA SEKOLAH</title>
    </head>
    <body class="bg-gray-50">
        <Header />

        <!-- Hero Section -->
        <section
            class="bg-gradient-to-r from-blue-700 to-blue-900 text-white py-20"
        >
            <div class="container mx-auto px-4 text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    Berita Sekolah
                </h1>
                <p class="text-xl">
                    Informasi terbaru seputar kegiatan dan prestasi
                </p>
            </div>
        </section>

        <!-- Filter Kategori -->
        <section class="py-12 bg-white">
            <div class="container mx-auto px-4">
                <div class="flex flex-wrap justify-center gap-4">
                    {
                        kategori.map((cat) => (
                            <a
                                href={`/berita?kategori=${cat.slug}`}
                                class={`px-6 py-2 rounded-full transition-colors
              ${
                  !Astro.url.searchParams.get("kategori") &&
                  cat.slug === "semua"
                      ? "bg-blue-600 text-white"
                      : Astro.url.searchParams.get("kategori") === cat.slug
                        ? "bg-blue-600 text-white"
                        : "border border-blue-600 text-blue-600 hover:bg-blue-100"
              }`}
                            >
                                {cat.nama}
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Daftar Berita -->
        <section class="py-16 bg-gray-100">
            <div class="container mx-auto px-4">
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {
                        berita.map((item) => (
                            <article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                                <img
                                    src={item.gambar}
                                    alt={item.judul}
                                    class="w-full h-48 object-cover"
                                />
                                <div class="p-6">
                                    <div class="flex justify-between items-center mb-3">
                                        <span
                                            class={`px-3 py-1 rounded-full text-xs font-medium
                  ${
                      item.kategori === "Prestasi"
                          ? "bg-green-100 text-green-800"
                          : item.kategori === "Kegiatan"
                            ? "bg-blue-100 text-blue-800"
                            : "bg-yellow-100 text-yellow-800"
                  }`}
                                        >
                                            {item.kategori}
                                        </span>
                                        <span class="text-sm text-gray-500">
                                            {item.tanggal}
                                        </span>
                                    </div>
                                    <h3 class="text-xl font-bold mb-2">
                                        {item.judul}
                                    </h3>
                                    <p class="text-gray-600 mb-4">
                                        {item.excerpt}
                                    </p>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-500">
                                            Oleh: {item.penulis}
                                        </span>
                                        <a
                                            href={`/berita/${item.id}`}
                                            class="text-blue-600 hover:underline text-sm font-medium"
                                        >
                                            Baca Selengkapnya →
                                        </a>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <!-- Pagination -->
                <div class="mt-6">
                    <Pagination
                        currentPage={1}
                        totalPages={3}
                        baseUrl="/berita"
                    />
                </div>
            </div>
        </section>

        <!-- Newsletter -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-4 max-w-4xl text-center">
                <h2 class="text-2xl font-bold text-blue-800 mb-4">
                    Dapatkan Update Berita
                </h2>
                <p class="text-gray-600 mb-6">
                    Berlangganan newsletter kami untuk mendapatkan informasi
                    terbaru
                </p>
                <form class="flex gap-2 justify-center p-2">
                    <input
                        type="email"
                        placeholder="Alamat email Anda"
                        class="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 flex-grow max-w-md"
                        required
                    />
                    <button
                        type="submit"
                        class="bg-blue-600 block hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-colors"
                    >
                        Berlangganan
                    </button>
                </form>
            </div>
        </section>

        <Footer />
    </body>
</html>
