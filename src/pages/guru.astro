---
// src/pages/guru.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const teams = await getCollection("team");
import diagram from "../media/diagram.png";

const categories = [
    { id: "all", label: "Semua" },
    { id: "kepsek", label: "Kepala Sekolah" },
    { id: "guru", label: "Guru" },
    { id: "staff", label: "Staf" },
];
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Guru & Staf - NAMA SEKOLAH</title>
        <style>
            .team-item {
                transition: all 0.3s ease;
                opacity: 0;
                animation: fadeIn 0.5s ease forwards;
            }
            @keyframes fadeIn {
                to {
                    opacity: 1;
                }
            }
        </style>
    </head>
    <body class="bg-gray-50">
        <Header />

        <!-- Hero Section -->
        <section
            class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-20"
        >
            <div class="container mx-auto px-4 text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">Guru & Staf</h1>
                <p class="text-xl">
                    Tenaga pendidik profesional yang berdedikasi
                </p>
            </div>
        </section>

        <!-- Daftar Guru & Staf -->
        <section class="py-16 bg-gray-100">
            <div class="container mx-auto px-4 space-y-8">
                <div class="flex flex-wrap justify-center gap-4">
                    {
                        categories.map((category) => (
                            <button
                                onclick={`filterTeam('${category.id}')`}
                                class="px-6 py-2 rounded-full border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors"
                            >
                                {category.label}
                            </button>
                        ))
                    }
                </div>
                <div
                    class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
                >
                    {
                        teams.map((person) => (
                            <div
                                class="team-item bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all"
                                data-category={person.data.kategori}
                            >
                                <Image
                                    src={person.data.foto}
                                    alt={person.data.nama}
                                    class="w-full h-64 object-cover"
                                />
                                <div class="p-6">
                                    <h3 class="text-xl font-bold">
                                        {person.data.nama}
                                    </h3>
                                    <p class="text-blue-600 font-medium">
                                        {person.data.jabatan}
                                    </p>
                                    {person.data.mapel !== "-" && (
                                        <p class="text-gray-600 mt-2">
                                            Mata Pelajaran: {person.data.mapel}
                                        </p>
                                    )}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Struktur Organisasi -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-4">
                <div class="max-w-4xl mx-auto">
                    <Image
                        src={diagram}
                        alt="Struktur Organisasi Sekolah"
                        class="w-full rounded-lg shadow-lg"
                    />
                </div>
            </div>
        </section>

        <Footer />
        <script is:inline>
            // Filter function untuk client-side
            function filterTeam(category) {
                const items = document.querySelectorAll(".team-item");
                items.forEach((item) => {
                    if (
                        category === "all" ||
                        item.dataset.category === category
                    ) {
                        item.classList.remove("hidden");
                    } else {
                        item.classList.add("hidden");
                    }
                });
            }
        </script>
    </body>
</html>
