---
// src/pages/index.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const data = await getCollection("blog");
const blogs = data.sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

//import image
import head from "../media/headmaster.jpg";
import galeri1 from "../media/galleri1.jpg";
import galeri2 from "../media/galleri2.jpg";
import galeri3 from "../media/galleri3.jpg";
import galeri4 from "../media/galleri4.jpg";

const galleries = [
	{
		title: "Galeri 1",
		image: galeri1,
	},
	{
		title: "Galeri 2",
		image: galeri2,
	},
	{
		title: "Galeri 3",
		image: galeri3,
	},
	{
		title: "Galeri 4",
		image: galeri4,
	},
];

const announcements = [
	{
		title: "PPDB 2024 Dibuka!",
		date: "15 Mei 2024",
		excerpt: "Pendaftaran siswa baru tahun ajaran 2024/2025",
	},
	{
		title: "Ujian Semester Genap",
		date: "1 Juni 2024",
		excerpt: "Jadwal ujian untuk kelas X-XII",
	},
];

const events = [
	{
		title: "Class Meeting",
		date: "10 Juni 2024",
		location: "Lapangan Sekolah",
	},
	{ title: "Study Tour", date: "20 Juni 2024", location: "Museum Nasional" },
];

const news = [
	{
		title: "Siswa Juara Olimpiade Matematika",
		image: "/news/math-olympiad.jpg",
		date: "5 Mei 2024",
	},
	{
		title: "Workshop Literasi Digital",
		image: "/news/digital-workshop.jpg",
		date: "12 Mei 2024",
	},
];
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>NAMA SEKOLAH - Sekolah Unggulan Berprestasi</title>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"
		/>

		<script
			src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"
		></script>
	</head>
	<body class="bg-gray-50 font-sans">
		<Header />

		<!-- Hero Slider with Splide -->
		<section class="relative">
			<div class="splide">
				<div class="splide__track">
					<ul class="splide__list">
						{
							blogs.slice(0, 3).map((slide) => (
								<li class="splide__slide">
									<div class="relative h-[500px]">
										<Image
											src={slide.data.cover}
											alt={slide.data.title}
											class="w-full h-full object-cover"
										/>
										<div class="absolute inset-0 bg-black/40 flex items-center">
											<div class="container mx-auto px-4 text-white">
												<h1 class="text-4xl md:text-5xl font-bold mb-4">
													{slide.data.title}
												</h1>
												{/* <p class="text-xl md:text-2xl max-w-2xl">
													{slide.subtitle}
												</p> */}
											</div>
										</div>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- 2. Sambutan Kepala Sekolah -->
		<section class="py-16 bg-white">
			<div
				class="container mx-auto px-4 flex flex-col md:flex-row items-center gap-8"
			>
				<div class="md:w-1/3">
					<Image
						src={head}
						alt="Kepala Sekolah"
						class="rounded-lg shadow-lg w-full max-w-xs mx-auto"
					/>
				</div>
				<div class="md:w-2/3">
					<h2 class="text-3xl font-bold text-blue-800 mb-6">
						Sambutan Kepala Sekolah
					</h2>

					<div class="text-gray-700 space-y-4">
						<p>
							Puji syukur kita panjatkan ke hadirat Tuhan Yang
							Maha Esa, atas rahmat dan karunia-Nya, kami dapat
							terus berkomitmen dalam menjalankan amanah
							pendidikan di lingkungan sekolah ini.
						</p>

						<p>
							Website resmi ini kami hadirkan sebagai media
							informasi, komunikasi, dan transparansi antara
							sekolah dengan seluruh warga sekolah, orang tua,
							alumni, dan masyarakat luas. Di era digital ini,
							keterbukaan informasi menjadi bagian penting dari
							pelayanan pendidikan yang berkualitas dan akuntabel.
						</p>

						<p>
							Melalui laman ini, kami berharap seluruh kegiatan,
							program, serta prestasi sekolah dapat tersampaikan
							dengan baik. Kami juga membuka ruang partisipasi
							aktif bagi semua pihak untuk bersama-sama membangun
							pendidikan yang unggul, berkarakter, dan relevan
							dengan perkembangan zaman.
						</p>

						<p>
							Akhir kata, kami ucapkan terima kasih atas
							kepercayaan dan dukungan yang telah diberikan kepada
							sekolah ini. Semoga website ini memberi manfaat dan
							mempererat hubungan antara sekolah dengan seluruh
							pemangku kepentingan.
						</p>

						<p class="font-medium">— Dr. John Doe, M.Pd.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. Pengumuman & Agenda -->
		<section class="py-16 bg-gray-100">
			<div class="container mx-auto px-4">
				<h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
					Informasi Terkini
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<!-- Pengumuman -->
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h3
							class="text-2xl font-semibold mb-4 flex items-center gap-2"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-6 w-6 text-blue-600"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
								></path>
							</svg>
							Pengumuman
						</h3>
						<ul class="space-y-4">
							{
								announcements.map((item) => (
									<li class="border-b pb-4 last:border-0">
										<h4 class="font-medium text-lg">
											{item.title}
										</h4>
										<p class="text-gray-500 text-sm">
											{item.date}
										</p>
										<p class="text-gray-700 mt-1">
											{item.excerpt}
										</p>
									</li>
								))
							}
						</ul>
						<a
							href="/berita"
							class="mt-4 inline-block text-blue-600 hover:underline"
							>Lihat Semua →</a
						>
					</div>

					<!-- Agenda -->
					<div class="bg-white p-6 rounded-lg shadow-md">
						<h3
							class="text-2xl font-semibold mb-4 flex items-center gap-2"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-6 w-6 text-blue-600"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
								></path>
							</svg>
							Agenda
						</h3>
						<ul class="space-y-4">
							{
								events.map((event) => (
									<li class="border-b pb-4 last:border-0">
										<h4 class="font-medium text-lg">
											{event.title}
										</h4>
										<div class="flex items-center text-gray-500 text-sm mt-1">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												class="h-4 w-4 mr-1"
												fill="none"
												viewBox="0 0 24 24"
												stroke="currentColor"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
												/>
											</svg>
											{event.date}
										</div>
										<div class="flex items-center text-gray-500 text-sm">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												class="h-4 w-4 mr-1"
												fill="none"
												viewBox="0 0 24 24"
												stroke="currentColor"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
												/>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
												/>
											</svg>
											{event.location}
										</div>
									</li>
								))
							}
						</ul>
						<a
							href="/agenda"
							class="mt-4 inline-block text-blue-600 hover:underline"
							>Lihat Kalender →</a
						>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. Berita & Prestasi -->
		<section class="py-16 bg-white">
			<div class="container mx-auto px-4">
				<h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
					Berita & Prestasi
				</h2>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
				>
					{
						blogs
							.slice(0, 3)
							.map((item) => (
								<Card
									title={item.data.title}
									image={item.data.cover}
									date={item.data.date}
									category={item.data.categories}
								/>
							))
					}
				</div>

				<div class="text-center mt-8">
					<a
						href="/berita"
						class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-colors"
					>
						Lihat Semua Berita
					</a>
				</div>
			</div>
		</section>

		<!-- 5. Galeri Foto -->
		<section class="py-16 bg-gray-100">
			<div class="container mx-auto px-4">
				<h2 class="text-3xl font-bold text-center text-blue-800 mb-12">
					Galeri Kegiatan
				</h2>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					{
						galleries.map((i) => (
							<a href="#" class="group">
								<Image
									src={i.image}
									alt={i.title}
									class="w-full h-40 object-cover rounded-lg group-hover:opacity-90 transition-opacity"
								/>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<Footer />
		<script is:inline>
			document.addEventListener("DOMContentLoaded", function () {
				new Splide(".splide", {
					type: "loop",
					autoplay: true,
					interval: 5000,
					arrows: true,
					pagination: true,
					cover: true,
					//heightRatio: 0.5,
					breakpoints: {
						768: {
							arrows: false,
						},
					},
				}).mount();
			});
		</script>
	</body>
</html>
