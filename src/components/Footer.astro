---
// src/components/Footer.astro

// Data Kontak Sekolah (bisa disesuaikan)
const contactInfo = {
    alamat: "Jl. Pendidikan No. 123, Kota Anda, Kode Pos 12345",
    telepon: "(021) 1234-5678",
    email: "info@sekolahanda.sch.id",
};

// Link Cepat (Tambahkan sesuai kebutuhan)
const quickLinks = [
    { name: "Beranda", path: "/" },
    { name: "Profil Sekolah", path: "/profil" },
    { name: "Pendaftaran", path: "/pendaftaran" },
    { name: "Berita", path: "/berita" },
    { name: "Galeri", path: "/galeri" },
    { name: "Kontak", path: "/kontak" },
];

// Sosial Media Sekolah
const socialMedia = [
    { name: "Facebook", icon: "facebook", url: "#" },
    { name: "Instagram", icon: "instagram", url: "#" },
    { name: "YouTube", icon: "youtube", url: "#" },
    { name: "Twitter", icon: "twitter", url: "#" },
];
---

<footer class="bg-gray-800 text-white pt-12 pb-6">
    <div class="container mx-auto px-4">
        <!-- Grid Layout untuk Footer -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
            <!-- Kolom 1: Tentang Sekolah -->
            <div class="space-y-4">
                <h3 class="text-xl font-bold text-blue-300">Tentang Kami</h3>
                <img
                    src="/favicon.svg"
                    alt="Logo Sekolah"
                    class="h-12 w-auto"
                />
                <p class="text-gray-300">
                    Sekolah unggulan dengan visi mencetak generasi berkarakter,
                    berprestasi, dan berakhlak mulia.
                </p>
            </div>

            <!-- Kolom 2: Link Cepat -->
            <div class="space-y-4">
                <h3 class="text-xl font-bold text-blue-300">Link Cepat</h3>
                <ul class="space-y-2">
                    {
                        quickLinks.map((link) => (
                            <li>
                                <a
                                    href={link.path}
                                    class="text-gray-300 hover:text-white transition-colors"
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Kolom 3: Kontak -->
            <div class="space-y-4">
                <h3 class="text-xl font-bold text-blue-300">Hubungi Kami</h3>
                <address class="not-italic text-gray-300 space-y-3">
                    <div class="flex items-start">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 mr-3 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span>{contactInfo.alamat}</span>
                    </div>
                    <div class="flex items-center">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 mr-3"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                        <span>{contactInfo.telepon}</span>
                    </div>
                    <div class="flex items-center">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 mr-3"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        <span>{contactInfo.email}</span>
                    </div>
                </address>
            </div>

            <!-- Kolom 4: Sosial Media -->
            <div class="space-y-4">
                <h3 class="text-xl font-bold text-blue-300">Media Sosial</h3>
                <div class="flex space-x-4">
                    {
                        socialMedia.map((social) => (
                            <a
                                href={social.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-gray-700 hover:bg-blue-600 p-2 rounded-full transition-colors"
                                aria-label={social.name}
                            >
                                <svg class="h-5 w-5">
                                    <use
                                        href={`/icons/sprite.svg#${social.icon}`}
                                    />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div
            class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-400"
        >
            <p>
                &copy; {new Date().getFullYear()} NAMA SEKOLAH. All Rights Reserved.
            </p>
            <p class="mt-2 text-sm">
                Dibangun dengan ❤️ menggunakan <a
                    href="https://astro.build"
                    target="_blank"
                    class="text-blue-300 hover:underline">Astro</a
                >
            </p>
        </div>
    </div>
</footer>
