---
// src/components/Header.astro

// Daftar menu navigasi (bisa disesuaikan)
const navItems = [
  { name: "Beranda", path: "/" },
  { name: "Profil", path: "/profil" },
  { name: "Program", path: "/program" },
  { name: "Guru & Staf", path: "/guru" },
  { name: "Siswa", path: "/siswa" },
  { name: "Berita", path: "/berita" },
  { name: "Pendaftaran", path: "/pendaftaran" },
  { name: "Kontak", path: "/kontak" },
];
---

<!-- Script Vanilla JS untuk toggle mobile menu -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const closeMenuButton = document.getElementById("close-mobile-menu");

    mobileMenuButton.addEventListener("click", () => {
      mobileMenu.classList.remove("translate-x-full");
      mobileMenu.classList.add("translate-x-0");
    });

    closeMenuButton.addEventListener("click", () => {
      mobileMenu.classList.remove("translate-x-0");
      mobileMenu.classList.add("translate-x-full");
    });
  });
</script>

<!-- Header/Navbar -->
<header class="bg-white shadow-md sticky top-0 z-50">
  <div
    class="container mx-auto px-4 lg:px-0 py-3 flex justify-between items-center"
  >
    <!-- Logo Sekolah -->
    <a href="/" class="flex items-center">
      <img src="/favicon.svg" alt="Logo Sekolah" class="h-12 w-auto" />
      <span class="sr-only ml-3 text-xl font-bold text-blue-800">
        NAMA SEKOLAH
      </span>
    </a>

    <!-- Desktop Navigation (Hidden di Mobile) -->
    <nav class="hidden lg:flex space-x-8">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class="text-gray-700 hover:text-blue-600 font-medium"
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- Mobile Menu Button (Muncul hanya di Mobile) -->
    <button
      id="mobile-menu-button"
      class="lg:hidden p-2 rounded-md text-gray-700 hover:bg-gray-100"
      aria-label="Buka Menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Off-Canvas Mobile Menu (Sidebar) -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-y-0 right-0 w-64 bg-white shadow-xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out"
  >
    <div class="flex justify-between items-center p-4 border-b">
      <span class="text-lg font-bold text-blue-800">MENU</span>
      <button
        id="close-mobile-menu"
        class="p-2 rounded-md text-gray-700 hover:bg-gray-100"
        aria-label="Tutup Menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex flex-col p-4 space-y-4">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class="py-2 px-3 text-gray-700 hover:bg-blue-50 rounded-md font-medium"
          >
            {item.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>
